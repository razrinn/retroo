# Security headers for every page and file (Cloudflare static assets read this file).
# CSP: everything from this site only; inline style attributes are allowed (Vue sets styles), scripts are not.
# data:/blob: images are for the summary image and the doodle snapshot. cloudflareinsights.com is Cloudflare
# Web Analytics (injected by the zone). Cloudflare's bot-detection inline script stays blocked: allowing it would
# need 'unsafe-inline'.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
